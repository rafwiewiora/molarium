{
  "name": "molarium-molecular-modeler",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:web": "node validation/validate-registry.mjs && bun scripts/build-web.mjs",
    "assets:download": "bun scripts/fetch-assets.mjs",
    "manifest:r2": "bun scripts/r2-assets.mjs",
    "upload:r2": "bun scripts/upload-r2-assets.mjs",
    "verify:r2": "bun scripts/verify-r2-assets.mjs",
    "dev": "bun --hot server.js",
    "dev:local": "bun --hot server.js --local-only",
    "start": "bun server.js",
    "start:local": "bun server.js --local-only",
    "manifest:local": "bun scripts/generate-local-lab-manifest.mjs",
    "build:validation-registry": "node validation/build-registry.mjs",
    "test:validation-registry": "node validation/validate-registry.mjs && node validation/dashboard.test.mjs",
    "test:local-lab": "bun local-lab-test.js",
    "test:development-log": "bun scripts/export-codex-session-test.mjs",
    "test:logo": "bun scripts/molarium-logo-test.mjs",
    "test:docking": "node docking/test.mjs && node docking/restraint-biased-search.test.mjs && node docking/ring-conformer-generator.test.mjs && node chemist-actions.test.mjs",
    "test:chemist-actions": "node chemist-actions.test.mjs",
    "test:chemist-actions-browser": "MOLARIUM_TEST_SCOPE=chemist-actions bun browser-test.js",
    "test:chemist-actions-production": "MOLARIUM_TEST_SCOPE=chemist-actions-production-boundary bun browser-test.js",
    "test:openmm-worker-browser": "MOLARIUM_TEST_SCOPE=openmm-worker-smoke bun browser-test.js",
    "test:enumerations": "node enumerations/enumerations.test.mjs",
    "test:docking-ring-conformers": "node docking/ring-conformer-generator.test.mjs",
    "test:docking-guided-search": "node docking/restraint-biased-search.test.mjs",
    "test:pose-propagation": "npm run test:docking && npm run test:docking-browser && npm run test:7kpa-contacts && npm run test:docking-benchmark-manifest",
    "test:docking-browser": "MOLARIUM_TEST_SCOPE=docking-contact-remap bun browser-test.js",
    "test:docking-benchmark-curation": "node docking/benchmark/validate-curation.mjs",
    "fixtures:docking-benchmark": "node docking/benchmark/fetch-rcsb-fixtures.mjs",
    "test:docking-benchmark-fixtures": "node docking/benchmark/validate-fixtures.mjs",
    "build:docking-benchmark-atom-maps": "node docking/benchmark/run-rdkit-python.mjs build-atom-maps.py",
    "test:docking-benchmark-atom-maps": "node docking/benchmark/validate-atom-maps.mjs",
    "scan:docking-benchmark-contacts": "bun docking/benchmark/scan-reference-interactions.mjs",
    "test:docking-benchmark-interactions": "node docking/benchmark/validate-interactions.mjs",
    "run:docking-benchmark": "bun docking/benchmark/run-browser-benchmark.mjs",
    "score:docking-benchmark": "node docking/benchmark/score-results.mjs",
    "test:docking-benchmark-results": "node docking/benchmark/validate-results.mjs",
    "build:docking-benchmark-manifest": "node docking/benchmark/build-manifest.mjs",
    "test:docking-benchmark-manifest": "node docking/benchmark/validate-manifest.mjs",
    "test:7kpa-analogue-panel": "node docking/benchmark/validate-7kpa-two-terminus-panel.mjs && node docking/benchmark/7kpa-two-terminus-panel.test.mjs",
    "run:7kpa-analogue-panel": "bun docking/benchmark/run-7kpa-two-terminus-panel.mjs",
    "run:7kpa-high-disruption": "bun docking/benchmark/run-7kpa-two-terminus-panel.mjs --enumerations",
    "test:7kpa-analogue-results": "node docking/benchmark/validate-7kpa-two-terminus-results.mjs",
    "test:7kpa-high-disruption-results": "node docking/benchmark/validate-7kpa-two-terminus-results.mjs --enumerations",
    "test:cloud-panel-packet": "node docking/validation/cloud-panel/build_pose_packet.test.mjs",
    "test:cloud-panel-shortlist": "node docking/validation/cloud-panel/build_shortlist.test.mjs",
    "test:openmm-wasm": "node docking/validation/cloud-panel/score_openmm_wasm.test.mjs",
    "test:pose-viewer": "node docking/validation/pose-viewer/pose-viewer.test.mjs",
    "test:7kpa-contacts": "MOLARIUM_TEST_SCOPE=7kpa-contact-capture MOLARIUM_PREPARATION_PDB=test/fixtures/7kpa.pdb MOLARIUM_PREPARATION_CCD=test/fixtures/D84.cif MOLARIUM_PREPARATION_CCD_ID=D84 MOLARIUM_PREPARATION_WATER_POLICY=retain bun browser-test.js",
    "test:7kpa-lactam-diagnostic": "MOLARIUM_TEST_SCOPE=7kpa-contact-capture MOLARIUM_PREPARATION_PDB=test/fixtures/7kpa.pdb MOLARIUM_PREPARATION_CCD=test/fixtures/D84.cif MOLARIUM_PREPARATION_CCD_ID=D84 MOLARIUM_PREPARATION_WATER_POLICY=retain MOLARIUM_DIAGNOSE_7KPA_LACTAM=1 bun browser-test.js",
    "test": "bun browser-test.js",
    "test:2d": "bun rdkit-depiction-browser-test.js",
    "test:ani-webgpu": "bun mlip-browser-test.js",
    "benchmark:rosemary": "bun rosemary-browser-benchmark.js",
    "arena:conformers": "bun conformer-browser-benchmark.js",
    "benchmark:conformer-value": "bun conformer-value-benchmark.js",
    "test:sage-golden": "bun openff/validate-golden.js",
    "test:openfold-features": "bun openfold-feature-test.js",
    "test:stormm-webgpu": "node stormm/test.mjs",
    "test:stormm-constraints": "node stormm/test.mjs --constraints-only",
    "test:stormm-openmm": "node stormm/openmm-reference-validation.mjs",
    "benchmark:stormm": "node stormm/openmm-reference-validation.mjs --benchmark",
    "test:ci:scientific": "npm run test:validation-registry && npm run test:docking && npm run test:enumerations && npm run test:7kpa-analogue-panel && npm run test:cloud-panel-packet && npm run test:cloud-panel-shortlist && npm run test:openmm-wasm && npm run test:pose-viewer && npm run test:openfold-features && npm run test:logo && npm run test:development-log",
    "test:ci:browser": "npm test && npm run test:2d && npm run test:chemist-actions-production && npm run test:openmm-worker-browser",
    "test:ci:webgpu": "npm run test:stormm-webgpu"
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "webgpu": "0.4.0"
  }
}
