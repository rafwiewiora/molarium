{
  "schema": "molarium.chemist-action-script/v1",
  "label": "SOS1 growth-clash-v7 concise selected Phe890 route · visible Molarium interface",
  "actions": [
    {
      "action": "designRoute.load",
      "args": {
        "routeId": "sos1-hit-only"
      },
      "caption": "Begin with the only allowed coordinates: the 5OVE/AXE hit"
    },
    {
      "action": "view.setMode",
      "args": {
        "mode": "build"
      },
      "caption": "Enter Design to make the first prospective design decision"
    },
    {
      "action": "protein.prepare",
      "args": {
        "gapPolicy": "cap",
        "histidine": "auto",
        "ligandPolicy": "ccd",
        "pH": 7.4,
        "repairMissingHeavy": true,
        "waterPolicy": "retain"
      },
      "caption": "Prepare the hit complex locally with OpenFF Sage"
    },
    {
      "action": "view.setDisplay",
      "args": {
        "representation": "cartoon",
        "showHydrogens": false,
        "showInteractions": false,
        "showPocketAtoms": true,
        "showHulls": false,
        "showStericClashes": false,
        "colorTheme": "design-hit",
        "changeMarkers": "halo"
      },
      "caption": "Strip away visual noise so the hit and its binding pocket are easy to read"
    },
    {
      "action": "view.focusComponent",
      "args": {
        "kind": "ligand",
        "ordinal": 0,
        "isolate": false
      },
      "caption": "Center the hit and the local pocket where every design decision will be made"
    },
    {
      "action": "pose.captureReference",
      "args": {
        "mode": "propagate"
      },
      "caption": "Freeze the hit pose and its receptor contacts as the starting reference"
    },
    {
      "action": "designRoute.applyStep",
      "args": {
        "stepId": "scaffold-rewrite"
      },
      "caption": "Rewrite the hit scaffold to make compound 17",
      "capture": {
        "changed-atoms-5": "designStep.changedAtomIds"
      }
    },
    {
      "action": "view.setDisplay",
      "args": {
        "colorTheme": "design-prediction"
      },
      "caption": "Mark the transition from experimental hit to prospective prediction"
    },
    {
      "action": "view.highlightAtoms",
      "args": {
        "atomIds": {
          "$binding": "changed-atoms-5"
        }
      },
      "caption": "See exactly where the ligand graph changed"
    },
    {
      "action": "pose.refine",
      "args": {
        "searchChains": 64,
        "featureSeedingProtocol": "v3"
      },
      "expect": {
        "refinement.selectedFeasible": true,
        "refinement.featureGuidedSeeding.method": "molarium-edit-region-axis-seeding/v3"
      },
      "caption": "Search 64 restrained poses for the rewritten scaffold"
    },
    {
      "action": "pose.apply",
      "args": {
        "index": 0
      },
      "expect": {
        "appliedPose.feasible": true
      },
      "caption": "Apply the highest-ranked compound 17 pose",
      "capture": {
        "changed-atoms-7": "appliedPose.changedAtomIds"
      }
    },
    {
      "action": "view.highlightAtoms",
      "args": {
        "atomIds": {
          "$binding": "changed-atoms-7"
        },
        "residueLabels": [
          {
            "chain": "A",
            "residueIndex": 890,
            "label": "Phe890",
            "tone": "gold"
          },
          {
            "chain": "A",
            "residueIndex": 898,
            "label": "Lys898",
            "tone": "blue"
          }
        ]
      },
      "caption": "Keep the same view: the predicted pyrazole packs between Phe890 and Lys898; no direct H-bond is detected"
    },
    {
      "action": "protein.parameterize",
      "args": {},
      "caption": "Parameterize compound 17 without moving the prediction"
    },
    {
      "action": "optimization.run",
      "args": {
        "method": "induced-fit-webgpu"
      },
      "caption": "Relax compound 17 and its pocket together",
      "capture": {
        "changed-atoms-9": "optimization.changedAtomIds"
      }
    },
    {
      "action": "view.highlightAtoms",
      "args": {
        "atomIds": []
      },
      "caption": "Compare the relaxed ligand–pocket geometry in the same fixed view"
    },
    {
      "action": "view.setMode",
      "args": {
        "mode": "build"
      },
      "caption": "Return to Design with the compound 17 prediction"
    },
    {
      "action": "pose.captureReference",
      "args": {
        "mode": "propagate"
      },
